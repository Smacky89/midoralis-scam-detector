# Copy this file to .env and fill it in. Never commit .env.
DISCORD_TOKEN=your_token_here

# Where to store data (hashes, settings, cases, logs). Defaults to ./scam-hashes.json
# BLOCKLIST_PATH=/app/data/scam-hashes.json

# Register slash commands in one server only (instant; handy while testing)
# DEV_GUILD_ID=123456789012345678

# Folder or URL containing eng.traineddata.gz, if the default OCR CDN is blocked
# OCR_LANG_PATH=
